XINFERENCE_BASE_URL=http://host.docker.internal:9997
DIFY_CHAT_URL=http://host.docker.internal:88/v1/chat-messages
DIFY_API_KEY=
LOCAL_TTS_BASE_URL=http://local-tts:8091
TTS_PROVIDER=piper
PIPER_BIN=/usr/local/bin/piper
PIPER_MODEL_PATH=/models/piper/zh_CN-huayan-medium.onnx
PIPER_CONFIG_PATH=/models/piper/zh_CN-huayan-medium.onnx.json
PIPER_NOISE_SCALE=0.4
PIPER_LENGTH_SCALE=1.05
PIPER_NOISE_W=0.7
PIPER_SENTENCE_SILENCE=0.12
